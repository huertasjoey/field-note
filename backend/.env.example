# Copy this file to .env and fill in your own values. Never commit .env.
PORT=5000
# Local MongoDB:   mongodb://127.0.0.1:27017/fieldnote
# MongoDB Atlas:   mongodb+srv://<username>:<password>@<cluster-host>/fieldnote?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/fieldnote
# Database name used for all collections
DB_NAME=fieldnote
# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173

# --- Authentication ---
# "production" enables Secure cookies. Required for real deployments (HTTPS).
NODE_ENV=development
# Cookie SameSite: lax (default; frontend and API on the same site, e.g. localhost)
# or none (frontend and API on different sites; requires HTTPS).
COOKIE_SAMESITE=lax
# Number of reverse proxies in front of the API (e.g. 1) so rate limiting sees real client IPs.
# TRUST_PROXY=1

# --- First administrator (used only by `npm run create-admin`) ---
# Choose your own strong password, run the script, then remove ADMIN_PASSWORD from .env.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
